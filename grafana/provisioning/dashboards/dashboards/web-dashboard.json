{
    "id":  null,
    "title":  "Web Application Monitoring",
    "tags":  [
                 "web",
                 "application"
             ],
    "timezone":  "browser",
    "schemaVersion":  39,
    "version":  1,
    "refresh":  "10s",
    "panels":  [
                   {
                       "id":  1,
                       "title":  "HTTP Request Rate",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  0,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "rate(http_requests_total[5m])",
                                           "legendFormat":  "{{method}} {{status_code}}",
                                           "refId":  "A"
                                       }
                                   ]
                   },
                   {
                       "id":  2,
                       "title":  "Response Time",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  12,
                                       "y":  0,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
                                           "legendFormat":  "95th Percentile",
                                           "refId":  "A"
                                       }
                                   ],
                       "yaxes":  [
                                     {
                                         "format":  "s",
                                         "label":  "Seconds",
                                         "logBase":  1
                                     }
                                 ]
                   },
                   {
                       "id":  3,
                       "title":  "Photos Uploaded",
                       "type":  "stat",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  8,
                                       "w":  6,
                                       "h":  4
                                   },
                       "targets":  [
                                       {
                                           "expr":  "photos_uploaded_total",
                                           "legendFormat":  "Photos Uploaded",
                                           "refId":  "A"
                                       }
                                   ]
                   },
                   {
                       "id":  4,
                       "title":  "Error Rate",
                       "type":  "stat",
                       "gridPos":  {
                                       "x":  6,
                                       "y":  8,
                                       "w":  6,
                                       "h":  4
                                   },
                       "targets":  [
                                       {
                                           "expr":  "rate(http_requests_total{status_code=~\"5..\"}[5m])",
                                           "legendFormat":  "5xx Errors",
                                           "refId":  "A"
                                       }
                                   ],
                       "colorBackground":  true
                   }
               ]
}