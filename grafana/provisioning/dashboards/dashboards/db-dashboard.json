{
    "id":  null,
    "title":  "MySQL Database Monitoring",
    "tags":  [
                 "mysql",
                 "database"
             ],
    "timezone":  "browser",
    "schemaVersion":  39,
    "version":  1,
    "refresh":  "10s",
    "panels":  [
                   {
                       "id":  1,
                       "title":  "MySQL Connections",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  0,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "mysql_global_status_threads_connected",
                                           "legendFormat":  "Connected Threads",
                                           "refId":  "A"
                                       },
                                       {
                                           "expr":  "mysql_global_status_threads_running",
                                           "legendFormat":  "Running Threads",
                                           "refId":  "B"
                                       }
                                   ]
                   },
                   {
                       "id":  2,
                       "title":  "MySQL Query Performance",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  12,
                                       "y":  0,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "rate(mysql_global_status_questions_total[5m])",
                                           "legendFormat":  "Questions/sec",
                                           "refId":  "A"
                                       }
                                   ]
                   },
                   {
                       "id":  3,
                       "title":  "MySQL Slow Queries",
                       "type":  "stat",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  8,
                                       "w":  6,
                                       "h":  4
                                   },
                       "targets":  [
                                       {
                                           "expr":  "mysql_global_status_slow_queries",
                                           "legendFormat":  "Slow Queries",
                                           "refId":  "A"
                                       }
                                   ],
                       "colorBackground":  true
                   },
                   {
                       "id":  4,
                       "title":  "MySQL InnoDB Buffer Pool",
                       "type":  "graph",
                       "gridPos":  {
                                       "x":  6,
                                       "y":  8,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "mysql_global_status_innodb_buffer_pool_pages_data",
                                           "legendFormat":  "Data Pages",
                                           "refId":  "A"
                                       }
                                   ]
                   }
               ]
}