<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head', { title: 'Chỉnh sửa Album' }) %>
</head>
<body>
    <%- include('../partials/navbar', { user }) %>

    <main class="container py-4" style="max-width: 720px;">
        <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom border-secondary border-opacity-25">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small text-muted font-monospace">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Lumina</a></li>
                        <li class="breadcrumb-item"><a href="/albums" class="text-decoration-none text-muted">Albums</a></li>
                        <li class="breadcrumb-item active text-primary" aria-current="page">Chỉnh sửa</li>
                    </ol>
                </nav>
                <h1 class="h3 fw-bold mb-0 text-white">Chỉnh sửa Album</h1>
            </div>
            <a href="/albums/<%= album.id %>" class="btn btn-secondary btn-sm">Quay lại album</a>
        </div>

        <% (messages?.error || []).forEach(function(message) { %>
            <div class="alert alert-danger"><%= message %></div>
        <% }); %>
        <% (messages?.success || []).forEach(function(message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% }); %>

        <div class="card p-4">
            <form action="/albums/<%= album.id %>/update" method="POST">
                <div class="mb-3">
                    <label class="form-label" for="album-title">Tiêu đề Album *</label>
                    <input id="album-title" type="text" name="title" class="form-control" value="<%= album.title %>" maxlength="255" required>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="album-description">Mô tả album</label>
                    <textarea id="album-description" name="description" class="form-control" rows="3"><%= album.description || '' %></textarea>
                </div>
                <div class="mb-4 form-check form-switch p-0 ps-5">
                    <input id="is-public" type="checkbox" name="is_public" class="form-check-input" <%= album.is_public ? 'checked' : '' %>>
                    <label class="form-check-label text-white fw-semibold" for="is-public">Album Công khai</label>
                    <div class="form-text text-muted small">Nếu tắt, chỉ chủ sở hữu hoặc người có liên kết khách mới có thể xem ảnh trong album.</div>
                </div>
                <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-25">
                    <a href="/albums/<%= album.id %>" class="btn btn-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
