<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Image Gallery</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="container my-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header"><h1 class="h3 mb-0">Edit Album</h1></div>
                    <div class="card-body">
                        <% (messages?.error || []).forEach(function(message) { %><div class="alert alert-danger"><%= message %></div><% }); %>
                        <form action="/albums/<%= album.id %>/update" method="POST">
                            <div class="mb-3">
                                <label class="form-label" for="album-title">Album title</label>
                                <input id="album-title" type="text" name="title" class="form-control" value="<%= album.title %>" maxlength="255" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="album-description">Description</label>
                                <textarea id="album-description" name="description" class="form-control" rows="4"><%= album.description || '' %></textarea>
                            </div>
                            <div class="form-check mb-3">
                                <input id="is-public" type="checkbox" name="is_public" class="form-check-input" <%= album.is_public ? 'checked' : '' %>>
                                <label class="form-check-label" for="is-public">Public album</label>
                            </div>
                            <button type="submit" class="btn btn-primary">Save changes</button>
                            <a href="/albums/<%= album.id %>" class="btn btn-secondary">Cancel</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
