<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head', { title: 'Chỉnh sửa Tác phẩm' }) %>
</head>
<body>
    <%- include('../partials/navbar', { user }) %>

    <main class="container py-4" style="max-width: 720px;">
        <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom border-secondary border-opacity-25">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small text-muted font-monospace">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Lumina</a></li>
                        <li class="breadcrumb-item"><a href="/photos" class="text-decoration-none text-muted">Ảnh</a></li>
                        <li class="breadcrumb-item active text-primary" aria-current="page">Chỉnh sửa</li>
                    </ol>
                </nav>
                <h1 class="h3 fw-bold mb-0 text-white">Chỉnh sửa Thông tin Ảnh</h1>
            </div>
            <a href="/photos/<%= photo.id %>" class="btn btn-secondary btn-sm">Quay lại chi tiết</a>
        </div>

        <% (messages?.error || []).forEach(function(message) { %>
            <div class="alert alert-danger"><%= message %></div>
        <% }); %>
        <% (messages?.success || []).forEach(function(message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% }); %>

        <div class="card p-4">
            <form action="/photos/<%= photo.id %>/update" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label class="form-label" for="photo-title">Tiêu đề ảnh *</label>
                    <input id="photo-title" type="text" name="title" class="form-control" value="<%= photo.title %>" maxlength="255" required>
                </div>
                <div class="mb-4">
                    <label class="form-label" for="photo-description">Mô tả tác phẩm</label>
                    <textarea id="photo-description" name="description" class="form-control" rows="4"><%= photo.description || '' %></textarea>
                </div>
                <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-25">
                    <a href="/photos/<%= photo.id %>" class="btn btn-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4">Lưu thông tin</button>
                </div>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
