<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Image Gallery</title>
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Gallery</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/albums">Albums</a></li>
                    <li class="nav-item"><a class="nav-link" href="/photos">Photos</a></li>
                </ul>
                <ul class="navbar-nav">
                    <% if (user && user.role === 'admin') { %><li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li><% } %>
                    <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <main class="container my-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header"><h1 class="h3 mb-0">Edit Photo</h1></div>
                    <div class="card-body">
                        <% (messages?.error || []).forEach(function(message) { %><div class="alert alert-danger"><%= message %></div><% }); %>
                        <form action="/photos/<%= photo.id %>/update" method="POST">
                            <div class="mb-3">
                                <label class="form-label" for="photo-title">Title</label>
                                <input id="photo-title" type="text" name="title" class="form-control" value="<%= photo.title %>" maxlength="255" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="photo-description">Description</label>
                                <textarea id="photo-description" name="description" class="form-control" rows="4"><%= photo.description || '' %></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">Save changes</button>
                            <a href="/photos/<%= photo.id %>" class="btn btn-secondary">Cancel</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
