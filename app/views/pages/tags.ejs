<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head', { title }) %>
</head>
<body>
    <%- include('../partials/navbar', { user, csrfToken }) %>

    <main class="container-fluid px-3 px-lg-4 my-4">
        <!-- Breadcrumbs & Heading -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-4 border-bottom border-secondary border-opacity-25">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small text-muted font-monospace">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Lumina</a></li>
                        <li class="breadcrumb-item active text-primary" aria-current="page">Phân loại ảnh</li>
                    </ol>
                </nav>
                <h1 class="h3 fw-bold mb-1 text-white">Phân loại ảnh &amp; Quản lý Thẻ</h1>
                <p class="text-muted mb-0 small">
                    Tổ chức cây danh mục, hệ thống nhãn và thẻ tag cho toàn bộ tác phẩm trong thư viện.
                </p>
            </div>
            <div class="d-flex gap-2">
                <a href="/photos" class="btn btn-secondary btn-sm">Xem tất cả ảnh</a>
                <% if (user) { %>
                    <a href="/photos/upload" class="btn btn-primary btn-sm">+ Tải ảnh lên</a>
                <% } %>
            </div>
        </div>

        <% (messages?.error || []).forEach(function(message) { %>
            <div class="alert alert-danger"><%= message %></div>
        <% }); %>
        <% (messages?.success || []).forEach(function(message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% }); %>

        <!-- Tags Cloud / Grid -->
        <section class="card mb-4" aria-labelledby="all-tags-heading">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 id="all-tags-heading" class="h6 mb-0 text-white fw-semibold d-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2">
                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                        <line x1="7" y1="7" x2="7.01" y2="7"></line>
                    </svg>
                    <span>Tất cả thẻ tag hiện có (<%= tags.length %>)</span>
                </h2>
                <span class="text-muted small">Bấm vào thẻ để lọc ảnh</span>
            </div>
            <div class="card-body">
                <% if (tags && tags.length > 0) { %>
                    <div class="d-flex flex-wrap gap-2">
                        <% tags.forEach(function(tag) { %>
                            <a href="/photos?tag=<%= encodeURIComponent(tag.name) %>" class="badge-tag d-inline-flex align-items-center gap-2 px-3 py-2 fs-6">
                                <span>#<%= tag.name %></span>
                                <span class="badge bg-dark bg-opacity-75 text-light rounded-pill font-monospace" style="font-size: 0.7rem;"><%= tag.photo_count %> ảnh</span>
                            </a>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="text-muted mb-0">Chưa có thẻ tag nào được tạo. Hãy tải ảnh lên hoặc thêm thẻ trong trang chi tiết ảnh.</p>
                <% } %>
            </div>
        </section>

        <!-- Recently Tagged Photos Showcase -->
        <section aria-labelledby="recent-tagged-heading">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 id="recent-tagged-heading" class="h5 mb-0 text-white fw-semibold">Ảnh được gắn thẻ gần đây</h2>
                <% if (recentPhotos && recentPhotos.length > 0) { %>
                    <button type="button" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1" data-start-slideshow data-album-title="Ảnh gắn thẻ gần đây">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                        <span>Trình chiếu nhóm ảnh</span>
                    </button>
                <% } %>
            </div>

            <% if (recentPhotos && recentPhotos.length > 0) { %>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3">
                    <% recentPhotos.forEach(function(photo) { %>
                        <div class="col">
                            <div class="card h-100">
                                <a href="/photos/<%= photo.id %>" class="d-block overflow-hidden" style="height: 190px;">
                                    <img src="<%= photo.thumbnailPath %>" 
                                         class="card-img-top w-100 h-100" 
                                         alt="<%= photo.title %>" 
                                         loading="lazy"
                                         data-cinema-slide="<%= photo.path %>"
                                         data-cinema-title="<%= photo.title %>"
                                         data-cinema-download="<%= photo.path %>">
                                </a>
                                <div class="card-body p-3">
                                    <h3 class="card-title h6 mb-1 text-truncate">
                                        <a href="/photos/<%= photo.id %>" class="text-white text-decoration-none"><%= photo.title %></a>
                                    </h3>
                                    <p class="text-muted small mb-2">
                                        <%= photo.album_title ? photo.album_title : 'Chưa phân album' %> • <%= photo.username %>
                                    </p>
                                    <div class="d-flex flex-wrap gap-1">
                                        <% photo.tags.forEach(function(tagName) { %>
                                            <a href="/photos?tag=<%= encodeURIComponent(tagName) %>" class="badge bg-secondary text-decoration-none" style="font-size: 0.7rem;">#<%= tagName %></a>
                                        <% }); %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="alert alert-info">Chưa có ảnh nào được gắn thẻ tag trong hệ thống.</div>
            <% } %>
        </section>
    </main>

    <%- include('../partials/slideshow') %>
    <%- include('../partials/footer') %>
    <script src="/js/gallery.js" defer></script>
</body>
</html>
