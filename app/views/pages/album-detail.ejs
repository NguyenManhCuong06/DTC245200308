<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Image Gallery</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Gallery</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link active" href="/albums">Albums</a></li>
                    <li class="nav-item"><a class="nav-link" href="/photos">Photos</a></li>
                </ul>
                <ul class="navbar-nav">
                    <% if (user) { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <%= user.username %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/logout">Logout</a></li>
                            </ul>
                        </li>
                    <% } else { %>
                        <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><%= album.title %></h1>
            <div>
                <a href="/albums" class="btn btn-secondary">Back to Albums</a>
                <% if (user && album.user_id == user.id) { %>
                    <a href="/albums/<%= album.id %>/edit" class="btn btn-outline-secondary ms-2">Edit Album</a>
                    <form action="/albums/<%= album.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this album?');">
                        <button type="submit" class="btn btn-outline-danger ms-2">Delete Album</button>
                    </form>
                    <a href="/photos/upload?album_id=<%= album.id %>" class="btn btn-primary ms-2">Add Photos</a>
                <% } %>
            </div>
        </div>

        <% if (album.description) { %>
            <div class="alert alert-info mb-4">
                <%= album.description %>
            </div>
        <% } %>

        <p class="text-muted">Created by <%= album.username %> on <%= new Date(album.created_at).toLocaleDateString() %></p>

        <% (messages?.error || []).forEach(function(message) { %><div class="alert alert-danger"><%= message %></div><% }); %>
        <% (messages?.success || []).forEach(function(message) { %><div class="alert alert-success"><%= message %></div><% }); %>
        <% if (user && album.user_id == user.id) { %>
            <section class="card mb-4" aria-labelledby="share-links-title">
                <div class="card-body">
                    <h2 id="share-links-title" class="h5">Guest share links</h2>
                    <form action="/albums/<%= album.id %>/shares" method="POST" class="d-flex flex-wrap align-items-end gap-2 mb-3">
                        <label for="share-expiry" class="form-label mb-0">Expires in</label>
                        <select id="share-expiry" name="expires_in_days" class="form-select w-auto">
                            <option value="1">1 day</option>
                            <option value="7" selected>7 days</option>
                            <option value="30">30 days</option>
                        </select>
                        <button type="submit" class="btn btn-success">Create share link</button>
                    </form>
                    <% if (shareLinks && shareLinks.length) { %>
                        <ul class="list-unstyled mb-0">
                            <% shareLinks.forEach(function(link) { %>
                                <li class="border-top py-2">
                                    <% if (!link.revoked_at && new Date(link.expires_at) > new Date()) { %>
                                        <a href="/share/<%= link.token %>" target="_blank" rel="noopener">Open guest link</a>
                                        <span class="text-muted">Expires <%= new Date(link.expires_at).toLocaleString() %></span>
                                        <form action="/albums/<%= album.id %>/shares/<%= link.id %>/revoke" method="POST" class="d-inline" onsubmit="return confirm('Revoke this share link?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                                        </form>
                                    <% } else { %>
                                        <span class="text-muted">Inactive share link</span>
                                    <% } %>
                                </li>
                            <% }); %>
                        </ul>
                    <% } else { %>
                        <p class="text-muted mb-0">No share links yet.</p>
                    <% } %>
                </div>
            </section>
        <% } %>

        <% if (photos && photos.length > 0) { %>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mt-4">
                <% photos.forEach(function(photo) { %>
                    <div class="col">
                        <div class="card h-100">
                            <button type="button" class="lightbox-trigger" data-full="<%= photo.originalPath %>" aria-label="View <%= photo.title %>">
                                <img src="<%= photo.path %>" class="card-img-top" alt="<%= photo.title %>" loading="lazy">
                            </button>
                            <div class="card-body">
                                <h5 class="card-title"><%= photo.title %></h5>
                                <% if (photo.tags && photo.tags.length) { %>
                                    <div class="photo-tags">
                                        <% photo.tags.forEach(function(tag) { %>
                                            <a href="/photos?tag=<%= encodeURIComponent(tag) %>" class="badge bg-secondary">#<%= tag %></a>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>
                            <div class="card-footer bg-transparent">
                                <a href="/photos/<%= photo.id %>" class="btn btn-sm btn-outline-primary">View</a>
                                <% if (user && album.user_id == user.id) { %>
                                    <a href="/photos/<%= photo.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form action="/photos/<%= photo.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this photo?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                <% } %>
                                <% if (photo.is_public) { %>
                                    <a href="/photos/<%= photo.id %>/share" class="btn btn-sm btn-outline-success" target="_blank">Share</a>
                                <% } %>
                            </div>
                            <dialog id="photo-lightbox" class="photo-lightbox">
                                <button type="button" class="btn btn-secondary lightbox-close" aria-label="Close">Close</button>
                                <img alt="">
                            </dialog>
                            <script src="/js/gallery.js" defer></script>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="alert alert-info mt-4">No photos in this album yet.</div>
        <% } %>
    </div>
    <footer class="bg-dark text-center text-white py-3 mt-5">
        <div class="container">
            <p class="mb-0">&copy; <%= new Date().getFullYear() %> Image Gallery.</p>
        </div>
    </footer>
</body>
</html>