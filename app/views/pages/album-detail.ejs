<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head', { title }) %>
</head>
<body>
    <%- include('../partials/navbar', { user }) %>

    <main class="container-fluid px-3 px-lg-4 my-4">
        <!-- Album Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 pb-3 mb-4 border-bottom border-secondary border-opacity-25">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small text-muted font-monospace">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Lumina</a></li>
                        <li class="breadcrumb-item"><a href="/albums" class="text-decoration-none text-muted">Albums</a></li>
                        <li class="breadcrumb-item active text-primary" aria-current="page"><%= album.title %></li>
                    </ol>
                </nav>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h1 class="h3 fw-bold mb-0 text-white"><%= album.title %></h1>
                    <% if (album.is_public) { %>
                        <span class="badge-public">Công khai</span>
                    <% } else { %>
                        <span class="badge-private">Riêng tư</span>
                    <% } %>
                </div>
                <p class="text-muted small mb-0 font-monospace">
                    Tạo bởi <strong class="text-white"><%= album.username %></strong> • <%= new Date(album.created_at).toLocaleDateString() %> • <%= photos ? photos.length : 0 %> ảnh
                </p>
            </div>

            <!-- Toolbar Actions -->
            <div class="d-flex flex-wrap gap-2">
                <% if (photos && photos.length > 0) { %>
                    <button type="button" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1" data-start-slideshow data-album-title="<%= album.title %>">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                        <span>Trình chiếu Cinema</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" id="batchDownloadBtn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        <span>Tải toàn bộ album</span>
                    </button>
                <% } %>
                <% if (user && (album.user_id == user.id || user.role === 'admin')) { %>
                    <a href="/photos/upload?album_id=<%= album.id %>" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        <span>+ Thêm ảnh</span>
                    </a>
                    <a href="/albums/<%= album.id %>/edit" class="btn btn-secondary btn-sm">Sửa album</a>
                    <form action="/albums/<%= album.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa album này?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Xóa album</button>
                    </form>
                <% } %>
                <a href="/albums" class="btn btn-secondary btn-sm">Quay lại</a>
            </div>
        </div>

        <% (messages?.error || []).forEach(function(message) { %>
            <div class="alert alert-danger"><%= message %></div>
        <% }); %>
        <% (messages?.success || []).forEach(function(message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% }); %>

        <% if (album.description) { %>
            <div class="alert alert-info mb-4">
                <%= album.description %>
            </div>
        <% } %>

        <!-- Shared Links Management (Stitch Shared Links Pattern) -->
        <% if (user && (album.user_id == user.id || user.role === 'admin')) { %>
            <section class="card mb-4" aria-labelledby="share-links-heading">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h2 id="share-links-heading" class="h6 mb-0 text-white fw-semibold d-flex align-items-center gap-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                        </svg>
                        <span>Liên kết chia sẻ khách (Shared Links &amp; Public Access)</span>
                    </h2>
                    <form action="/albums/<%= album.id %>/shares" method="POST" class="d-flex align-items-center gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <label for="share-expiry" class="small text-muted mb-0">Thời hạn:</label>
                        <select id="share-expiry" name="expires_in_days" class="form-select form-select-sm w-auto">
                            <option value="1">1 ngày</option>
                            <option value="7" selected>7 ngày</option>
                            <option value="30">30 ngày</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary">+ Tạo link mới</button>
                    </form>
                </div>
                <div class="card-body p-3">
                    <% if (typeof shareLinks !== 'undefined' && shareLinks && shareLinks.length > 0) { %>
                        <div class="list-group list-group-flush">
                            <% shareLinks.forEach(function(link) { %>
                                <div class="list-group-item bg-transparent text-white px-0 py-2 d-flex flex-wrap justify-content-between align-items-center gap-2 border-secondary border-opacity-25">
                                    <div class="d-flex align-items-center gap-2">
                                        <% if (!link.revoked_at && new Date(link.expires_at) > new Date()) { %>
                                            <span class="badge bg-success bg-opacity-25 text-success font-monospace" style="font-size: 0.72rem;">Đang hoạt động</span>
                                            <a href="/share/<%= link.token %>" target="_blank" class="text-info font-monospace text-decoration-none small">
                                                /share/<%= link.token.slice(0, 16) %>...
                                            </a>
                                            <span class="text-muted small">• Hết hạn: <%= new Date(link.expires_at).toLocaleString() %></span>
                                        <% } else { %>
                                            <span class="badge bg-secondary text-muted font-monospace" style="font-size: 0.72rem;">Đã thu hồi / Hết hạn</span>
                                            <span class="text-muted font-monospace small">/share/<%= link.token.slice(0, 12) %>...</span>
                                        <% } %>
                                    </div>
                                    <div>
                                        <% if (!link.revoked_at && new Date(link.expires_at) > new Date()) { %>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 me-1" style="font-size: 0.75rem;" onclick="navigator.clipboard.writeText(window.location.origin + '/share/<%= link.token %>'); alert('Đã sao chép link chia sẻ vào clipboard!');">
                                                Sao chép link
                                            </button>
                                            <form action="/albums/<%= album.id %>/shares/<%= link.id %>/revoke" method="POST" class="d-inline" onsubmit="return confirm('Thu hồi quyền truy cập của liên kết này?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.75rem;">Thu hồi</button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <p class="text-muted mb-0 small">Chưa có liên kết chia sẻ nào được tạo cho album này.</p>
                    <% } %>
                </div>
            </section>
        <% } %>

        <!-- Photos in Album Grid -->
        <% if (photos && photos.length > 0) { %>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4 mb-4">
                <% photos.forEach(function(photo) { %>
                    <div class="col">
                        <div class="card h-100">
                            <!-- Image container with Cinema Slideshow and Batch Download triggers -->
                            <div class="position-relative overflow-hidden" style="height: 220px;">
                                <a href="/photos/<%= photo.id %>" class="d-block w-100 h-100">
                                    <img src="<%= photo.thumbnailPath %>" 
                                         class="card-img-top w-100 h-100" 
                                         alt="<%= photo.title %>" 
                                         loading="lazy"
                                         data-cinema-slide="<%= photo.originalPath %>"
                                         data-cinema-title="<%= photo.title %>"
                                         data-cinema-download="<%= photo.originalPath %>"
                                         data-download-url="<%= photo.originalPath %>"
                                         data-filename="<%= photo.filename %>">
                                </a>
                                <div class="position-absolute top-0 end-0 m-2">
                                    <% if (photo.is_public) { %>
                                        <span class="badge-public">Công khai</span>
                                    <% } else { %>
                                        <span class="badge-private">Riêng tư</span>
                                    <% } %>
                                </div>
                            </div>

                            <div class="card-body p-3 d-flex flex-column">
                                <h2 class="card-title h6 mb-1 text-truncate">
                                    <a href="/photos/<%= photo.id %>" class="text-white text-decoration-none"><%= photo.title %></a>
                                </h2>
                                <% if (photo.tags && photo.tags.length) { %>
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        <% photo.tags.forEach(function(tag) { %>
                                            <a href="/photos?tag=<%= encodeURIComponent(tag) %>" class="badge bg-secondary text-decoration-none" style="font-size: 0.7rem;">#<%= tag %></a>
                                        <% }); %>
                                    </div>
                                <% } %>

                                <div class="mt-auto pt-2 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                                    <a href="/photos/<%= photo.id %>" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.8rem;">Xem chi tiết</a>
                                    <div class="d-flex gap-1">
                                        <% if (user && (album.user_id == user.id || user.role === 'admin')) { %>
                                            <a href="/photos/<%= photo.id %>/edit" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.8rem;">Sửa</a>
                                            <form action="/photos/<%= photo.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Xóa ảnh này khỏi album?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.8rem;">Xóa</button>
                                            </form>
                                        <% } %>
                                        <a href="<%= photo.originalPath || photo.path %>" class="btn btn-sm btn-secondary py-0 px-2" style="font-size: 0.8rem;" download title="Tải ảnh">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                                <polyline points="7 10 12 15 17 10"></polyline>
                                                <line x1="12" y1="15" x2="12" y2="3"></line>
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="card p-5 text-center">
                <p class="text-muted mb-3">Chưa có bức ảnh nào trong album này.</p>
                <% if (user && (album.user_id == user.id || user.role === 'admin')) { %>
                    <div>
                        <a href="/photos/upload?album_id=<%= album.id %>" class="btn btn-primary btn-sm">+ Thêm ảnh vào album ngay</a>
                    </div>
                <% } %>
            </div>
        <% } %>
    </main>

    <%- include('../partials/slideshow') %>
    <%- include('../partials/footer') %>
    <script src="/js/gallery.js" defer></script>
</body>
</html>