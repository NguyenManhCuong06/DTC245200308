<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Image Gallery</title>
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Gallery</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/albums">Albums</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/photos">Photos</a></li>
                </ul>
                <ul class="navbar-nav">
                    <% if (user && user.role === 'admin') { %><li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li><% } %>
                    <% if (user) { %>
                        <li class="nav-item"><a class="nav-link" href="/photos/upload">Upload</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <%= user.username %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/logout">Logout</a></li>
                            </ul>
                        </li>
                    <% } else { %>
                        <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container mt-4">
        <h1 class="mb-4">All Photos</h1>
        <% (messages?.error || []).forEach(function(message) { %><div class="alert alert-danger"><%= message %></div><% }); %>
        <% (messages?.success || []).forEach(function(message) { %><div class="alert alert-success"><%= message %></div><% }); %>
        <form action="/photos" method="GET" class="mb-4 d-flex flex-wrap gap-2">
            <label for="photo-search" class="visually-hidden">Search photos, tags or albums</label>
            <input id="photo-search" type="search" name="q" class="form-control search-control" placeholder="Search photo, tag or album" value="<%= searchTerm || '' %>">
            <label for="tag-filter" class="visually-hidden">Filter by exact tag</label>
            <input id="tag-filter" type="search" name="tag" class="form-control search-control" placeholder="Exact tag filter" value="<%= activeTag || '' %>">
            <button type="submit" class="btn btn-outline-primary">Search</button>
            <% if (activeTag || searchTerm) { %><a href="/photos" class="btn btn-secondary">Clear</a><% } %>
        </form>
        <% if (activeTag) { %><p class="text-muted">Tag: <strong><%= activeTag %></strong></p><% } %>
        
        <% if (user) { %>
            <div class="mb-3">
                <a href="/photos/upload" class="btn btn-primary">Upload New Photo</a>
            </div>
        <% } %>

        <% if (photos && photos.length > 0) { %>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                <% photos.forEach(function(photo) { %>
                    <div class="col">
                        <div class="card h-100">
                            <button type="button" class="lightbox-trigger" data-full="/photos/<%= photo.id %>/original" aria-label="View <%= photo.title %>">
                                <img src="<%= photo.path %>" class="card-img-top" alt="<%= photo.title %>" loading="lazy">
                            </button>
                            <div class="card-body">
                                <h5 class="card-title"><%= photo.title %></h5>
                                <p class="card-text text-muted small"><%= photo.album_title || 'Uncategorized' %></p>
                                <% if (photo.tag_names) { %>
                                    <div class="photo-tags">
                                        <% photo.tag_names.split(',').forEach(function(tag) { %>
                                            <a href="/photos?tag=<%= encodeURIComponent(tag) %>" class="badge bg-secondary">#<%= tag %></a>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>
                            <div class="card-footer bg-transparent">
                                <a href="/photos/<%= photo.id %>" class="btn btn-sm btn-outline-primary">View</a>
                                <% if (user && photo.user_id == user.id) { %>
                                    <a href="/photos/<%= photo.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form action="/photos/<%= photo.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this photo?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                <% } %>
                                <% if (photo.is_public) { %>
                                    <a href="/photos/<%= photo.id %>/share" class="btn btn-sm btn-outline-success" target="_blank">Share</a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
        </div>
        <% } else { %>
            <div class="alert alert-info"><%= activeTag || searchTerm ? 'No photos match these filters.' : 'No photos found. Upload one to get started!' %></div>
        <% } %>
        <% if (totalPages > 1) { %>
            <nav class="d-flex justify-content-between align-items-center my-4" aria-label="Photo pages">
                <% if (previousUrl) { %><a class="btn btn-outline-primary" href="<%= previousUrl %>">Previous</a><% } else { %><span></span><% } %>
                <span>Page <%= currentPage %> of <%= totalPages %> (<%= totalCount %> photos)</span>
                <% if (nextUrl) { %><a class="btn btn-outline-primary" href="<%= nextUrl %>">Next</a><% } else { %><span></span><% } %>
            </nav>
        <% } %>
    </div>
    <dialog id="photo-lightbox" class="photo-lightbox">
        <button type="button" class="btn btn-secondary lightbox-close" aria-label="Close">Close</button>
        <img alt="">
    </dialog>
    <footer class="bg-dark text-center text-white py-3 mt-5">
        <div class="container">
            <p class="mb-0">&copy; <%= new Date().getFullYear() %> Image Gallery.</p>
        </div>
    </footer>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/gallery.js" defer></script>
</body>
</html>