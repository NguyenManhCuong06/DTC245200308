<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head', { title: 'Đăng nhập Studio' }) %>
</head>
<body class="d-flex flex-column min-vh-100">
    <%- include('../partials/navbar', { user: null }) %>

    <main class="container my-auto py-5 d-flex align-items-center justify-content-center">
        <div class="card shadow-lg auth-card p-4">
            <div class="text-center mb-4">
                <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-15 mb-2">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </div>
                <h1 class="h4 fw-bold text-white mb-1">Đăng nhập Studio</h1>
                <p class="text-muted small mb-0">Hệ thống Thư viện Ảnh Lumina Gallery</p>
            </div>

            <% if (error && error.length > 0) { %>
                <% const errorMsg = Array.isArray(error) ? error[0] : error; %>
                <div class="alert alert-danger py-2 small"><%= errorMsg %></div>
            <% } %>
            <% (success || []).forEach(function(message) { %>
                <div class="alert alert-success py-2 small"><%= message %></div>
            <% }); %>

            <form action="/login" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label class="form-label" for="email">Địa chỉ Email</label>
                    <input id="email" type="email" name="email" class="form-control" placeholder="nhap@email.com" required autofocus>
                </div>
                <div class="mb-4">
                    <label class="form-label" for="password">Mật khẩu</label>
                    <input id="password" type="password" name="password" class="form-control" placeholder="••••••••" required>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2">Đăng nhập ngay</button>
            </form>

            <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25 small text-muted">
                Chưa có tài khoản? <a href="/register" class="text-primary text-decoration-none fw-semibold">Đăng ký thành viên</a>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>