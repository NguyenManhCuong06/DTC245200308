<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head', { title: 'Tạo Album Mới' }) %>
</head>
<body>
    <%- include('../partials/navbar', { user, csrfToken }) %>

    <main class="container py-4" style="max-width: 720px;">
        <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom border-secondary border-opacity-25">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small text-muted font-monospace">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Lumina</a></li>
                        <li class="breadcrumb-item"><a href="/albums" class="text-decoration-none text-muted">Albums</a></li>
                        <li class="breadcrumb-item active text-primary" aria-current="page">Tạo mới</li>
                    </ol>
                </nav>
                <h1 class="h3 fw-bold mb-0 text-white">Tạo Bộ Sưu Tập / New Album</h1>
            </div>
            <a href="/albums" class="btn btn-secondary btn-sm">Quay lại danh sách</a>
        </div>

        <% (messages?.error || []).forEach(function(message) { %>
            <div class="alert alert-danger"><%= message %></div>
        <% }); %>
        <% (messages?.success || []).forEach(function(message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% }); %>

        <div class="card p-4">
            <form action="/albums" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label class="form-label" for="title">Tên Album / Tiêu đề bộ sưu tập *</label>
                    <input id="title" type="text" name="title" class="form-control" placeholder="Ví dụ: Kỷ yếu 2026, Mùa thu Hà Nội..." required autofocus>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="description">Mô tả album</label>
                    <textarea id="description" name="description" class="form-control" rows="3" placeholder="Ghi chú về album, địa điểm hoặc thông điệp..."></textarea>
                </div>
                <div class="mb-4 form-check form-switch p-0 ps-5">
                    <input type="checkbox" name="is_public" class="form-check-input" id="is_public" checked>
                    <label class="form-check-label text-white fw-semibold" for="is_public">Album Công khai</label>
                    <div class="form-text text-muted small">Bật để cho phép mọi người xem trong thư viện. Tắt nếu muốn đặt riêng tư (chỉ bạn hoặc người có liên kết chia sẻ xem được).</div>
                </div>
                <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-25">
                    <a href="/albums" class="btn btn-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4">+ Tạo Album</button>
                </div>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>