<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head', { title: album.title }) %>
</head>
<body>
    <!-- Clean Guest Header for Shared Album -->
    <header class="py-3 px-4 border-bottom border-secondary border-opacity-25" style="background-color: #0d121f;">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
                <span class="fw-bold text-white fs-5">Lumina Gallery</span>
                <span class="badge bg-primary bg-opacity-25 text-primary ms-1 font-monospace">Khách xem Album</span>
            </div>
            <div>
                <a href="/login" class="btn btn-sm btn-outline-secondary">Đăng nhập Studio</a>
            </div>
        </div>
    </header>

    <main class="container-fluid px-3 px-lg-4 my-4">
        <!-- Hero Album Showcase -->
        <div class="p-4 p-md-5 mb-4 rounded-3 border border-secondary border-opacity-25 text-center position-relative overflow-hidden" 
             style="background: radial-gradient(circle at center, rgba(79,70,229,0.12) 0%, #0f172a 75%);">
            <div class="badge bg-success bg-opacity-25 text-success mb-2 px-3 py-1 font-monospace">
                ✓ Liên kết chia sẻ an toàn
            </div>
            <h1 class="display-6 fw-bold text-white mb-2"><%= album.title %></h1>
            <p class="text-secondary mb-3 small font-monospace">
                Bộ sưu tập của <strong class="text-white"><%= album.username %></strong> • <%= photos.length %> tác phẩm
            </p>
            <% if (album.description) { %>
                <p class="text-muted mx-auto mb-4" style="max-width: 650px;"><%= album.description %></p>
            <% } %>

            <div class="d-flex justify-content-center gap-2">
                <% if (photos && photos.length > 0) { %>
                    <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2" data-start-slideshow data-album-title="<%= album.title %>">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                        <span>Trình chiếu toàn màn hình</span>
                    </button>
                    <button type="button" class="btn btn-secondary d-inline-flex align-items-center gap-2" id="batchDownloadBtn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        <span>Tải toàn bộ album</span>
                    </button>
                <% } %>
            </div>
        </div>

        <!-- Photos Grid -->
        <% if (photos && photos.length > 0) { %>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4 mb-4">
                <% photos.forEach(function(photo) { %>
                    <div class="col">
                        <div class="card h-100">
                            <div class="position-relative overflow-hidden" style="height: 220px;">
                                <img src="<%= photo.thumbnailPath %>" 
                                     class="card-img-top w-100 h-100" 
                                     alt="<%= photo.title %>" 
                                     loading="lazy"
                                     data-cinema-slide="<%= photo.originalPath %>"
                                     data-cinema-title="<%= photo.title %>"
                                     data-cinema-download="<%= photo.originalPath %>"
                                     data-download-url="<%= photo.originalPath %>"
                                     data-filename="<%= photo.title %>">
                            </div>
                            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                                <span class="card-title h6 mb-0 text-white text-truncate"><%= photo.title %></span>
                                <a href="<%= photo.originalPath %>" class="btn btn-sm btn-outline-primary py-0 px-2" download title="Tải ảnh">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                        <polyline points="7 10 12 15 17 10"></polyline>
                                        <line x1="12" y1="15" x2="12" y2="3"></line>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="alert alert-info text-center py-4">Album này hiện chưa có bức ảnh nào.</div>
        <% } %>
    </main>

    <%- include('../partials/slideshow') %>
    <%- include('../partials/footer') %>
    <script src="/js/gallery.js" defer></script>
</body>
</html>
