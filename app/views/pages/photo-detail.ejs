<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head', { title }) %>
</head>
<body>
    <%- include('../partials/navbar', { user }) %>

    <main class="container-fluid px-3 px-lg-4 my-4">
        <!-- Breadcrumbs & Navigation -->
        <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom border-secondary border-opacity-25">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small text-muted font-monospace">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Lumina</a></li>
                    <li class="breadcrumb-item"><a href="/photos" class="text-decoration-none text-muted">Ảnh</a></li>
                    <% if (photo.album_id) { %>
                        <li class="breadcrumb-item"><a href="/albums/<%= photo.album_id %>" class="text-decoration-none text-muted"><%= photo.album_title %></a></li>
                    <% } %>
                    <li class="breadcrumb-item active text-primary text-truncate" aria-current="page" style="max-width: 200px;"><%= photo.title %></li>
                </ol>
            </nav>
            <div class="d-flex gap-2">
                <a href="/photos" class="btn btn-secondary btn-sm">Quay lại thư viện</a>
            </div>
        </div>

        <% (messages?.error || []).forEach(function(message) { %>
            <div class="alert alert-danger"><%= message %></div>
        <% }); %>
        <% (messages?.success || []).forEach(function(message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% }); %>

        <div class="row g-4">
            <!-- Left Canvas: Large Image Theater -->
            <div class="col-lg-8">
                <div class="card p-2 text-center" style="background-color: #060911;">
                    <a href="<%= photo.path %>" target="_blank" class="d-inline-block w-100">
                        <img src="<%= photo.path %>" 
                             class="img-fluid rounded" 
                             alt="<%= photo.title %>" 
                             style="max-height: 72vh; object-fit: contain;">
                    </a>
                </div>
            </div>

            <!-- Right Sidebar: EXIF Inspector & Actions -->
            <div class="col-lg-4">
                <div class="card p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h1 class="h5 fw-bold text-white mb-0"><%= photo.title %></h1>
                        <% if (photo.is_public) { %>
                            <span class="badge-public">Công khai</span>
                        <% } else { %>
                            <span class="badge-private">Riêng tư</span>
                        <% } %>
                    </div>
                    <p class="text-muted small mb-3">
                        <%= photo.description || 'Chưa có mô tả cho tác phẩm này.' %>
                    </p>

                    <!-- Tags Management Section -->
                    <div class="mb-3 pt-3 border-top border-secondary border-opacity-25">
                        <h2 class="h6 text-white mb-2 fw-semibold d-flex align-items-center gap-1">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2">
                                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                                <line x1="7" y1="7" x2="7.01" y2="7"></line>
                            </svg>
                            <span>Thẻ Tag (<%= (photo.tags || []).length %>)</span>
                        </h2>
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            <% (photo.tags || []).forEach(function(tag) { %>
                                <span class="badge-tag d-inline-flex align-items-center">
                                    <a href="/photos?tag=<%= encodeURIComponent(tag.name) %>" class="text-decoration-none text-reset">#<%= tag.name %></a>
                                    <% if (user && (photo.user_id == user.id || user.role === 'admin')) { %>
                                        <form action="/photos/<%= photo.id %>/tags/<%= tag.id %>/remove" method="POST" class="d-inline ms-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="border-0 bg-transparent text-danger p-0 ms-1 fw-bold" style="font-size: 0.8rem; line-height: 1;" title="Xóa thẻ">&times;</button>
                                        </form>
                                    <% } %>
                                </span>
                            <% }); %>
                        </div>

                        <% if (user && (photo.user_id == user.id || user.role === 'admin')) { %>
                            <form action="/photos/<%= photo.id %>/tags" method="POST" class="input-group input-group-sm mt-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <span class="input-group-text bg-dark border-secondary text-muted">#</span>
                                <input name="tag_name" class="form-control" placeholder="Thêm thẻ mới..." maxlength="50" required>
                                <button type="submit" class="btn btn-outline-primary">+ Thêm</button>
                            </form>
                        <% } %>
                    </div>

                    <!-- Technical Telemetry / EXIF Panel -->
                    <div class="exif-panel mb-3">
                        <div class="small fw-semibold text-white mb-2 text-uppercase tracking-wider">Thông số kỹ thuật</div>
                        <div class="exif-item">
                            <span class="exif-label">Người tải lên</span>
                            <span class="exif-value"><%= photo.username %></span>
                        </div>
                        <div class="exif-item">
                            <span class="exif-label">Thuộc Album</span>
                            <span class="exif-value"><%= photo.album_title ? photo.album_title : 'Ảnh tự do' %></span>
                        </div>
                        <div class="exif-item">
                            <span class="exif-label">Ngày tạo</span>
                            <span class="exif-value"><%= new Date(photo.created_at).toLocaleString() %></span>
                        </div>
                        <div class="exif-item">
                            <span class="exif-label">Tên file lưu trữ</span>
                            <span class="exif-value text-truncate" style="max-width: 160px;" title="<%= photo.filename %>"><%= photo.filename %></span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex flex-column gap-2 pt-2">
                        <a href="<%= photo.path %>" class="btn btn-primary btn-sm d-flex align-items-center justify-content-center gap-2" download>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                            <span>Tải ảnh gốc xuống</span>
                        </a>

                        <% if (user && (photo.user_id == user.id || user.role === 'admin')) { %>
                            <div class="d-flex gap-2">
                                <a href="/photos/<%= photo.id %>/edit" class="btn btn-secondary btn-sm flex-grow-1">Chỉnh sửa thông tin</a>
                                <form action="/photos/<%= photo.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa ảnh này vĩnh viễn?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Xóa ảnh</button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>